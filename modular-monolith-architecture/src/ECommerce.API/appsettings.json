{
  "Database": { "Provider": "SqlServer", "DefaultConnectionName": "DefaultConnection", "ApplyMigrationsOnStartup": false, "SeedDevelopmentData": false },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ECommerceDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "PostgreSqlConnection": "Host=localhost;Port=5432;Database=ECommerceDb;Username=postgres;Include Error Detail=true"
  },
  "Jwt": { "Issuer": "ECommerce.API", "Audience": "ECommerce.Client", "SecretKey": "CHANGE_THIS_DEVELOPMENT_SECRET_KEY_32_CHARS_MINIMUM", "AccessTokenMinutes": 15, "RefreshTokenDays": 7 },
  "SerilogSettings": { "SlowRequestThresholdMilliseconds": 1000, "RetainedFileCountLimit": 14 },
  "AllowedHosts": "*",
  "Serilog": { "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } } }
}
